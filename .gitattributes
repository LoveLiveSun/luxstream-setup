# Windows skripte moraju ostati CRLF - PowerShell 5.1 i cmd to ocekuju
*.ps1 text eol=crlf
*.cmd text eol=crlf
*.bat text eol=crlf
*.vbs text eol=crlf
*.md  text eol=lf
*.ico binary
# Zakrpe moraju ostati LF - git apply ih poredi s LF izvorima, a
# autocrlf=true bi ih na Windowsu prepisao u CRLF i razbio kontekst.
*.patch text eol=lf
