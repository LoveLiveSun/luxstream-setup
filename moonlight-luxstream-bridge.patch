+        qint64 endMs = 0;         // when it ended, while the window is still up
+        qint64 lastPaintMs = 0;
+        bool shown = false;
+    };
+
+    void jobStart(bool sending, const QString& label, qint64 bytes);
+    void jobExtend(bool sending, const QString& label, qint64 bytes);
+    void jobAdvance(bool sending, qint64 bytes);
+    void jobFinish();
+    void jobTick();
+
+    static QString sanitizeName(const QString& name);
+    static QString freeName(const QString& dir, const QString& name);
+    static QString md5hex(const QByteArray& data);
+
+    // freeName plus the names already promised to a queued file. A single poll
+    // tick of pollDropFolder can now queue several files, and none of them has
+    // reached the disk yet, so the on-disk check alone cannot tell them apart -
+    // two of them would be handed the same destination.
+    QString reserveName(const QString& dir, const QString& name);
+
+    // Expands what was on the clipboard (files AND folders) into the files that
+    // actually go on the wire, each with the relative path the other side needs
+    // to rebuild the tree. A folder is walked recursively and its own name
+    // becomes the first path segment.
+    static QVector<QPair<QString, QString>> expandPaths(const QStringList& items);
+
+    // Where an incoming file lands. With "rel" the path is rebuilt under
+    // Primljeno\, creating folders on the way; without it the file goes flat
+    // into Primljeno\ as before, with the usual collision suffix.
+    QString destForRel(const QString& rel, const QString& fallbackName);
+
+    // Mirrors the PowerShell half, which reads all three kinds in one pass and
+    // in a deliberate order: files first, then text, then image. Copying a file
+    // in Explorer sets CF_HDROP but usually also CF_UNICODETEXT holding the
+    // path, so text-first would ship the path and never the file.
+    enum class ClipKind { None, Text, Image, Files };
+
+    ClipKind readClipboard(QString* text, QByteArray* png, QStringList* files) const;
+    void applyClipboard(const QString& text, const QByteArray& png, const QStringList& files);
+    void rememberCurrentClipboard();
+    QString hashOf(ClipKind kind, const QString& text, const QByteArray& png,
+                   const QStringList& files) const;
+
+    int m_Port = 51888;
+    QString m_Secret;
+    QStringList m_AllowedClients;
+    QString m_ConfigPath;
+    QString m_LogPath;
+    QString m_DropDir;
+    QString m_ReceivedDir;
+    QString m_SentDir;
+
+    // Hash of the clipboard content we already know about, so a change we made
+    // ourselves is not immediately sent back to the other side.
+    QString m_LastHash = QStringLiteral("N");
+
+    // What applyClipboard() last put on the clipboard. The re-read that follows
+    // it can come back empty when another process holds the clipboard, and
+    // without this the bridge would take the other side's own content for a
+    // fresh change and bounce it straight back.
+    QString m_AppliedHash;
+
+    // After the clipboard is set from the network it must be re-read and
+    // remembered. Re-reading (rather than reusing the hash we received) also
+    // covers the case where a re-encoded PNG does not come back byte-identical.
+    // The window is one poll interval: it only has to cover that settling, and
+    // every millisecond beyond it hides copies the user makes in the meantime -
+    // two copies inside the window used to mean the first one was never sent.
+    qint64 m_SkipUntilMs = 0;
+
+    QHash<QTcpSocket*, Connection*> m_Connections;
+    QTcpServer* m_Server = nullptr;
+    QTimer m_PollTimer;
+
+    // The job label as it was before a hold appended its hint to it, so the bar
+    // can go back to the plain file name once the paste has happened.
+    QString m_HoldLabelBase;
+
+    // What has already left Drop\, keyed by name|size|mtime so a file that is
+    // still being copied in is not sent half-way.
+    QHash<QString, bool> m_SentDropKeys;
+
+    // Destinations already promised to a file that is queued but not yet moved.
+    QSet<QString> m_ReservedDests;
+
+    Job m_Job;
+
+    static constexpr int kPollMs = 400;
+    static constexpr int kChunkBytes = 256 * 1024;
+    static constexpr int kLogMaxBytes = 2 * 1024 * 1024;
+    static constexpr qint64 kMaxTextBytes = 1024 * 1024;
+    static constexpr qint64 kMaxImageBytes = 16 * 1024 * 1024;
+    static constexpr qint64 kMaxFrameBytes = 64 * 1024 * 1024;
+    // 0 znaci "bez gornje granice" i to je zadano. Datoteka se salje u
+    // komadima od kChunkBytes, a druga strana svaki komad odmah zapisuje na
+    // disk - velicina datoteke zato ne odreduje ni potrosnju memorije ni
+    // velicinu pojedinog okvira. Granica velicine je bila samo politika, ne
+    // tehnicka nuznost, pa je nema. Postavi na >0 da je vratis.
+    static constexpr qint64 kClipFileMaxBytes = 0;
+    static constexpr qint64 kDropFileMaxBytes = 0;
+    static constexpr qint64 kSendBufferHighWater = 4 * 1024 * 1024;
+
+    // The progress window is not worth a window for a copy that is over before
+    // the eye reaches it, so it only appears for transfers of some size that
+    // are also still running after kProgressShowDelayMs. After the transfer
+    // ends the window stays up for kProgressKeepMs so the 100% is seen.
+    static constexpr qint64 kProgressMinBytes = 2 * 1024 * 1024;
+    static constexpr qint64 kProgressShowDelayMs = 600;
+    static constexpr qint64 kProgressKeepMs = 1200;
+
+    // How often the window is redrawn. Chunks arrive every few milliseconds, so
+    // without a limit this would repaint hundreds of times a second for a
+    // number nobody can read that fast.
+    static constexpr qint64 kProgressPaintMs = 200;
+
+    // No byte in either direction for this long, while something is in flight,
+    // means the socket is dead. 20 s sits far above anything a working link
+    // does (the slowest measured transfer here was ~34 MB/s) and far below the
+    // hours it takes Windows to give up on its own.
+    static constexpr qint64 kStallTimeoutMs = 20000;
+
+    // How long a peer may hold a transfer while its user pastes. The other side
+    // gives up on its own sooner (LazyCekajSec, 10 min) and falls back to a
+    // normal transfer, so this is only the backstop for a peer that vanished
+    // mid-pause without closing the socket.
+    static constexpr qint64 kHoldTimeoutMs = 15 * 60 * 1000;
+};
