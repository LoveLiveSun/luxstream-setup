+    void sendFileHeader(Connection* conn, const TxItem& item);
+
+    bool queueFile(Connection* conn, TxItem item);
+
+    // Fills the socket's write buffer from the queue until the high-water mark
+    // is reached, then returns to the event loop; the rest is driven by
+    // onBytesWritten. This is what replaced waitForBytesWritten - that call
+    // re-entered the event loop for socket traffic only, so the window and the
+    // clipboard poll stood still for as long as the transfer lasted.
+    void pumpSend(Connection* conn);
+
+    // Ends the file currently on the wire: end frame, close, move-if-Drop.
+    void finishCurrentSend(Connection* conn);
+
+    // Drops everything this connection still had queued to send and lifts the
