+LuxBridge* LuxBridge::start()
+{
+    auto* bridge = new LuxBridge(qApp);
+
+    if (!bridge->begin()) {
+        delete bridge;
+        return nullptr;
+    }
+
+    return bridge;
+}
+
+LuxBridge::LuxBridge(QObject* parent)
+    : QObject(parent)
+{
+    const QString home = QDir::homePath();
+    m_DropDir = QDir::toNativeSeparators(home + "/Luxstream/Drop");
+    m_ReceivedDir = QDir::toNativeSeparators(home + "/Luxstream/Primljeno");
+    m_SentDir = QDir::toNativeSeparators(home + "/Luxstream/Poslano");
+    m_LogPath = QDir::toNativeSeparators(home + "/Luxstream/luxstream-bridge.log");
+
+    const QByteArray programData = qgetenv("ProgramData");
+    const QString base = programData.isEmpty() ? QStringLiteral("C:\\ProgramData")
+                                              : QString::fromLocal8Bit(programData);
+    m_ConfigPath = QDir::toNativeSeparators(base + "/Luxstream/bridge.json");
+}
+
+LuxBridge::~LuxBridge()
+{
+    m_PollTimer.stop();
+
+    for (auto it = m_Connections.begin(); it != m_Connections.end(); ++it) {
+        if (it.value()->rxActive) {
+            it.value()->rxFile.close();
+        }
+        if (it.value()->txActive) {
+            it.value()->txFile.close();
+        }
+        delete it.value();
+    }
+    m_Connections.clear();
+
+    delete m_Server;
+    m_Server = nullptr;
+}
+
+bool LuxBridge::isListening() const
+{
+    return m_Server != nullptr && m_Server->isListening();
+}
+
+void LuxBridge::ensureFolders()
+{
+    for (const QString& dir : { m_DropDir, m_ReceivedDir, m_SentDir }) {
+        QDir().mkpath(dir);
+    }
+}
+
+void LuxBridge::log(const QString& message)
+{
+    const QString line = QDateTime::currentDateTime().toString("yyyy-MM-dd HH:mm:ss") + QStringLiteral("  ") + message;
+
+    QFileInfo fi(m_LogPath);
+    if (fi.exists() && fi.size() > kLogMaxBytes) {
+        QFile::remove(m_LogPath + QStringLiteral(".1"));
+        QFile::rename(m_LogPath, m_LogPath + QStringLiteral(".1"));
+    }
+
+    QFile f(m_LogPath);
+    if (f.open(QIODevice::WriteOnly | QIODevice::Append | QIODevice::Text)) {
+        f.write(line.toUtf8());
+        f.write("\r\n");
+        f.close();
+    }
+}
+
+bool LuxBridge::begin()
+{
+    ensureFolders();
+
+    QFile cfg(m_ConfigPath);
+    if (!cfg.exists()) {
+        log(QStringLiteral("most nije pokrenut: nema %1").arg(m_ConfigPath));
+        return false;
+    }
+
+    if (!cfg.open(QIODevice::ReadOnly)) {
+        log(QStringLiteral("most nije pokrenut: ne mogu citati %1").arg(m_ConfigPath));
+        return false;
+    }
+
+    const QJsonDocument doc = QJsonDocument::fromJson(cfg.readAll());
+    cfg.close();
+
+    if (!doc.isObject()) {
+        log(QStringLiteral("most nije pokrenut: %1 nije ispravan JSON").arg(m_ConfigPath));
+        return false;
+    }
+
+    const QJsonObject obj = doc.object();
+
+    m_Port = obj.value(QStringLiteral("port")).toInt(51888);
+    m_Secret = obj.value(QStringLiteral("secret")).toString();
+
+    m_AllowedClients.clear();
+    const QJsonValue allowed = obj.value(QStringLiteral("allowedClients"));
+    if (allowed.isArray()) {
+        for (const QJsonValue& v : allowed.toArray()) {
+            const QString prefix = v.toString();
+            if (!prefix.isEmpty()) {
+                m_AllowedClients.append(prefix);
+            }
+        }
+    }
+    if (m_AllowedClients.isEmpty()) {
+        m_AllowedClients = { QStringLiteral("172.29."), QStringLiteral("192.168."),
+                             QStringLiteral("10."), QStringLiteral("127.") };
+    }
+
+    // The shared secret is optional. It only stops accidental connections; the
+    // real gate is the address allow list above. With no secret configured the
+    // server accepts any greeting - which is what "no secret" has to mean, or a
+    // client that was never told the secret could never connect and the failure
+    // would look like "nothing happens" on both machines.
+    if (m_Secret.isEmpty()) {
+        log(QStringLiteral("most radi bez zajednicke tajne - provjerava se samo popis dopustenih adresa"));
+    }
+
+    if (m_Port <= 0 || m_Port > 65535) {
+        log(QStringLiteral("most nije pokrenut: neispravan port %1").arg(m_Port));
+        return false;
+    }
+
+    m_Server = new QTcpServer(this);
+    if (!m_Server->listen(QHostAddress::Any, static_cast<quint16>(m_Port))) {
+        log(QStringLiteral("most nije pokrenut: port %1 se ne moze otvoriti (%2)")
+                .arg(m_Port).arg(m_Server->errorString()));
+        delete m_Server;
+        m_Server = nullptr;
+        return false;
+    }
+
+    connect(m_Server, &QTcpServer::newConnection, this, &LuxBridge::onNewConnection);
+
+    m_PollTimer.setInterval(kPollMs);
+    m_PollTimer.setTimerType(Qt::CoarseTimer);
+    connect(&m_PollTimer, &QTimer::timeout, this, &LuxBridge::onPoll);
+    m_PollTimer.start();
+
+    log(QStringLiteral("posluzitelj pokrenut, port %1, dopusteni: %2")
+            .arg(m_Port).arg(m_AllowedClients.join(QLatin1Char(','))));
+    return true;
+}
+
+// The listener is dual stack (QHostAddress::Any), so on Windows an IPv4 client
+// arrives as an IPv4-mapped IPv6 address: "::ffff:127.0.0.1". Compared against a
+// list of IPv4 prefixes that never matches, and every connection is refused -
+// including the machine's own. The PowerShell half never hit this because it
+// used a plain IPv4 listener. Reduce the mapped form back to dotted IPv4 before
+// anything looks at it.
+QString LuxBridge::canonicalPeer(const QHostAddress& address)
+{
+    if (address.isNull()) {
+        return QStringLiteral("?");
+    }
+
+    // Qt prints IPv4-mapped addresses as "::ffff:a.b.c.d", which is not a valid
+    // IPv6 literal spelling but is what toString() hands back. Anything left of
+    // the last colon is the marker; the rest is the IPv4 address.
+    const QString text = address.toString();
+    if (text.startsWith(QStringLiteral("::ffff:"))) {
+        const QString ipv4 = text.mid(7);
+        if (!ipv4.isEmpty() && ipv4.at(0).isDigit()) {
+            return ipv4;
+        }
+    }
+
+    // Localhost over IPv6 is the same client as localhost over IPv4.
+    if (address.isLoopback() && address.protocol() == QAbstractSocket::IPv6Protocol) {
+        return QStringLiteral("127.0.0.1");
+    }
+
+    return text;
+}
+
+void LuxBridge::onNewConnection()
+{
+    while (m_Server != nullptr && m_Server->hasPendingConnections()) {
+        QTcpSocket* socket = m_Server->nextPendingConnection();
+
+        auto* conn = new Connection;
+        conn->socket = socket;
+        conn->peer = canonicalPeer(socket->peerAddress());
+
+        bool allowed = false;
+        for (const QString& prefix : m_AllowedClients) {
+            if (conn->peer.startsWith(prefix)) {
+                allowed = true;
+                break;
+            }
+        }
+
+        if (!allowed) {
+            // Refused before a single frame is read, exactly like the
+            // PowerShell half. The log line matters: a silent refusal here is
+            // indistinguishable from "the other side never tried".
+            log(QStringLiteral("ODBIJEN %1 (nije na popisu dopustenih)").arg(conn->peer));
+            socket->abort();
+            socket->deleteLater();
+            delete conn;
+            continue;
+        }
+
+        m_Connections.insert(socket, conn);
+        connect(socket, &QTcpSocket::readyRead, this, &LuxBridge::onReadyRead);
+        connect(socket, &QTcpSocket::bytesWritten, this, &LuxBridge::onBytesWritten);
+        connect(socket, &QTcpSocket::disconnected, this, &LuxBridge::onDisconnected);
+    }
+}
+
+void LuxBridge::onReadyRead()
+{
+    auto* socket = qobject_cast<QTcpSocket*>(sender());
+    if (socket == nullptr) {
+        return;
+    }
+
+    auto it = m_Connections.find(socket);
+    if (it == m_Connections.end()) {
+        return;
+    }
+
+    Connection* conn = it.value();
+    conn->buffer.append(socket->readAll());
+    processBuffer(conn);
+}
+
+void LuxBridge::onBytesWritten(qint64 bytes)
+{
+    auto* socket = qobject_cast<QTcpSocket*>(sender());
+    if (socket == nullptr) {
+        return;
+    }
+
+    auto it = m_Connections.find(socket);
+    if (it == m_Connections.end()) {
+        return;
+    }
+
+    Q_UNUSED(bytes);
+
+    // Bytes really left the socket, so this connection is alive. See
+    // checkStalls for what happens when this stamp stops moving.
+    it.value()->txProgressMs = QDateTime::currentMSecsSinceEpoch();
+
+    // The buffer has drained, so there is room for the next chunks. Without
+    // this the transfer would stop at the first high-water mark.
+    pumpSend(it.value());
+}
+
+void LuxBridge::onDisconnected()
+{
+    auto* socket = qobject_cast<QTcpSocket*>(sender());
+    if (socket == nullptr) {
+        return;
+    }
+
+    auto it = m_Connections.find(socket);
+    if (it == m_Connections.end()) {
+        return;
+    }
+
+    Connection* conn = it.value();
+
+    // A half-received file must not be left behind looking complete.
+    if (conn->rxActive) {
+        conn->rxFile.close();
+        log(QStringLiteral("  [!] veza prekinuta usred datoteke %1 - ostaje na disku")
+                .arg(QFileInfo(conn->rxPath).fileName()));
+    }
+
+    // What never went out has to be forgettable, or it would be dropped for
+    // good: a queued Drop file is already marked as sent, so losing the queue
+    // without handing the mark back means that file is never tried again.
+    if (conn->txActive) {
+        conn->txFile.close();
+        conn->txActive = false;
+        if (!conn->txCurrent.dropKey.isEmpty()) {
+            m_SentDropKeys.remove(conn->txCurrent.dropKey);
+        }
+        log(QStringLiteral("  [!] veza prekinuta usred slanja %1").arg(conn->txCurrent.name));
+    }
+    while (!conn->txQueue.isEmpty()) {
+        const TxItem item = conn->txQueue.dequeue();
+        if (!item.dropKey.isEmpty()) {
+            m_SentDropKeys.remove(item.dropKey);
+        }
+    }
+    // Queued for a move but not moved: the file is still in Drop\, so it has to
+    // stay on the list of things still to send.
+    for (const TxItem& item : conn->txMoves) {
+        if (!item.dropKey.isEmpty()) {
+            m_SentDropKeys.remove(item.dropKey);
+        }
+    }
+    conn->txMoves.clear();
+    conn->txBusy = false;
+
+    if (!conn->rejected) {
+        log(QStringLiteral("veza s %1 zatvorena").arg(conn->peer));
+    }
+
+    m_Connections.erase(it);
+    socket->deleteLater();
+    delete conn;
+
+    // Nothing can move any more, so a transfer that was on screen has to be
+    // taken down instead of sitting at its last percentage forever.
+    if (m_Connections.isEmpty() && m_Job.active) {
+        jobFinish();
+    }
+}
+
+void LuxBridge::dropStalePeers(Connection* keep)
+{
+    if (keep == nullptr) {
+        return;
+    }
+
+    // Collected first, hung up second: abort() can emit disconnected, which
+    // erases the entry from m_Connections and deletes the Connection, and
+    // doing that while iterating over the map it lives in is a use-after-free.
+    QVector<QTcpSocket*> stale;
+    for (auto it = m_Connections.constBegin(); it != m_Connections.constEnd(); ++it) {
+        Connection* other = it.value();
+        if (other == keep || !other->greeted || other->peer != keep->peer) {
+            continue;
+        }
+        stale.append(other->socket);
+    }
+
+    if (stale.isEmpty()) {
+        return;
+    }
+
+    log(QStringLiteral("  [!] %1 se ponovno spojio - zatvaram %2 stariju vezu")
+            .arg(keep->peer).arg(stale.size()));
+
+    for (QTcpSocket* socket : stale) {
+        auto it = m_Connections.find(socket);
+        if (it == m_Connections.end()) {
+            continue;
+        }
+        if (it.value()->rxActive) {
+            it.value()->rxFile.close();
+            it.value()->rxActive = false;
+        }
+        // Marked as a deliberate hang-up so the log does not also report it as
+        // an unexpected "veza zatvorena" right after the line above.
+        it.value()->rejected = true;
+        socket->abort();
+    }
+}
+
+void LuxBridge::checkStalls()
+{
+    const qint64 now = QDateTime::currentMSecsSinceEpoch();
+
+    QVector<QTcpSocket*> dead;
+    for (auto it = m_Connections.constBegin(); it != m_Connections.constEnd(); ++it) {
+        Connection* conn = it.value();
+        if (!conn->greeted) {
+            continue;
+        }
+
+        // A pause the far side asked for is not a stall. Without the txHeld
+        // test the 20 s rule below would abort every held transfer, and the
+        // hold would be useless for anything but a paste made within 20 s.
+        const bool busyTx = (conn->txActive || !conn->txQueue.isEmpty()) && !conn->txHeld;
+        if (busyTx && conn->txProgressMs != 0 && now - conn->txProgressMs > kStallTimeoutMs) {
+            log(QStringLiteral("  [!] %1: nista nije otislo %2 s - veza je mrtva, prekidam")
+                    .arg(conn->peer).arg(kStallTimeoutMs / 1000));
+            dead.append(conn->socket);
+            continue;
+        }
+
+        // Backstop for a pause that never ends: the other side gives up on its
+        // own after 10 minutes and continues the transfer normally, so reaching
+        // this means it died mid-pause without closing the socket.
+        if (conn->txHeld && conn->txHeldMs != 0 && now - conn->txHeldMs > kHoldTimeoutMs) {
+            log(QStringLiteral("  [!] %1: pauza traje duze od %2 min - prekidam")
+                    .arg(conn->peer).arg(kHoldTimeoutMs / 60000));
+            dead.append(conn->socket);
+            continue;
+        }
+
+        if (conn->rxActive && conn->rxProgressMs != 0 && now - conn->rxProgressMs > kStallTimeoutMs) {
+            if (conn->rxFile.isOpen()) {
+                conn->rxFile.close();
+            }
+            conn->rxActive = false;
+            conn->groupActive = false;
+            conn->groupPaths.clear();
+            log(QStringLiteral("  [!] %1: nista nije primljeno %2 s - veza je mrtva, prekidam")
+                    .arg(conn->peer).arg(kStallTimeoutMs / 1000));
+            dead.append(conn->socket);
+        }
+    }
+
+    for (QTcpSocket* socket : dead) {
+        auto it = m_Connections.find(socket);
+        if (it == m_Connections.end()) {
+            continue;
+        }
+        // The reason is already in the log; abort brings onDisconnected, which
+        // hands queued Drop files back so they are tried again after the
+        // reconnect instead of being lost.
+        if (it.value()->txActive) {
+            it.value()->txFile.close();
+            it.value()->txActive = false;
+        }
+        it.value()->txHeld = false;
+        it.value()->txHeldMs = 0;
+        it.value()->rejected = true;
+        socket->abort();
+    }
+}
+
+void LuxBridge::processBuffer(Connection* conn)
+{
+    while (conn->buffer.size() >= 5) {
+        const quint8 type = static_cast<quint8>(conn->buffer.at(0));
+        const qint32 len = qFromLittleEndian<qint32>(reinterpret_cast<const void*>(conn->buffer.constData() + 1));
+
+        if (len < 0 || len > kMaxFrameBytes) {
+            log(QStringLiteral("  [!] neispravna duljina okvira %1 od %2").arg(len).arg(conn->peer));
+            conn->socket->abort();
+            return;
+        }
+
+        if (conn->buffer.size() < 5 + len) {
+            return;     // wait for the rest
+        }
+
+        const QByteArray payload = conn->buffer.mid(5, len);
+        conn->buffer.remove(0, 5 + len);
+
+        if (!handleFrame(conn, type, payload)) {
+            return;
+        }
+    }
+}
+
+bool LuxBridge::handleFrame(Connection* conn, quint8 type, const QByteArray& payload)
+{
+    if (!conn->greeted) {
+        if (type != kFrameGreeting) {
+            log(QStringLiteral("ODBIJEN %1 - prvi okvir nije pozdrav (%2)").arg(conn->peer).arg(type));
+            conn->socket->abort();
+            return false;
+        }
+
+        const QJsonDocument doc = QJsonDocument::fromJson(payload);
+        const QString secret = doc.isObject() ? doc.object().value(QStringLiteral("secret")).toString()
+                                              : QString();
+
+        if (!m_Secret.isEmpty() && secret != m_Secret) {
+            log(QStringLiteral("ODBIJEN %1 - pogresna tajna").arg(conn->peer));
+            sendFrame(conn, kFrameGreetingReply, QByteArrayLiteral("NO"));
+            conn->socket->flush();
+            conn->rejected = true;
+            conn->socket->disconnectFromHost();
+            return false;
+        }
+
+        sendFrame(conn, kFrameGreetingReply, QByteArrayLiteral("OK"));
+        conn->greeted = true;
+        log(QStringLiteral("spojen %1").arg(conn->peer));
+
+        // The client reconnects after a link blip. Whatever it left behind is
+        // still listed here as connected (no FIN ever arrives - see
+        // checkStalls), and two connections to one machine would make
+        // firstLiveConnection() a coin toss.
+        dropStalePeers(conn);
+
+        // Whatever is in the clipboard right now becomes the baseline, so the
+        // first poll does not immediately push a stale copy at the other side.
+        rememberCurrentClipboard();
+        return true;
+    }
+
+    switch (type) {
+    case kFrameText:
+    {
+        if (payload.size() > kMaxTextBytes) {
+            log(QStringLiteral("  [!] tekst prevelik (%1 B)").arg(payload.size()));
+            break;
+        }
+
+        const QString text = QString::fromUtf8(payload);
+        if (!text.isEmpty()) {
+            applyClipboard(text, QByteArray(), QStringList());
+            QString preview = text.left(40);
+            if (text.length() > 40) {
+                preview += QStringLiteral("...");
+            }
+            preview.replace(QLatin1Char('\r'), QLatin1Char(' '));
+            preview.replace(QLatin1Char('\n'), QLatin1Char(' '));
+            log(QStringLiteral("  <- tekst %1 B  %2").arg(payload.size()).arg(preview));
+            rememberCurrentClipboard();
+        }
+        break;
+    }
+
+    case kFrameImage:
+    {
+        if (payload.size() > kMaxImageBytes) {
+            log(QStringLiteral("  [!] slika prevelika (%1 B)").arg(payload.size()));
+            break;
+        }
+
+        applyClipboard(QString(), payload, QStringList());
+        log(QStringLiteral("  <- slika %1 B").arg(payload.size()));
+        rememberCurrentClipboard();
+        break;
+    }
+
+    case kFrameClipGroup:
+    {
+        const QJsonDocument doc = QJsonDocument::fromJson(payload);
+        const int count = doc.isObject() ? doc.object().value(QStringLiteral("count")).toInt() : 0;
+        const qint64 total = doc.isObject() ? static_cast<qint64>(doc.object().value(QStringLiteral("ukupno")).toDouble()) : 0;
+        conn->groupActive = true;
+        conn->groupRemaining = count;
+        conn->groupPaths.clear();
+        log(QStringLiteral("  <- najava grupe: %1 datoteka, %2 MB")
+                .arg(count).arg(QString::number(total / 1048576.0, 'f', 1)));
+
+        // The announce already knows the whole group, so the bar can start
+        // there instead of crawling up one file header at a time.
+        jobStart(false, QStringLiteral("%1 datoteka").arg(count), total);
+        break;
+    }
+
+    case kFrameFileHeader:
+    {
+        const QJsonDocument doc = QJsonDocument::fromJson(payload);
+        if (!doc.isObject()) {
+            log(QStringLiteral("  [!] najava datoteke nije JSON"));
+            break;
+        }
+
+        const QString name = sanitizeName(doc.object().value(QStringLiteral("name")).toString());
+        const QString rel = doc.object().value(QStringLiteral("rel")).toString();
+        const qint64 declared = static_cast<qint64>(doc.object().value(QStringLiteral("size")).toDouble());
+        const QString dest = rel.isEmpty() ? freeName(m_ReceivedDir, name)
+                                           : destForRel(rel, name);
+
+        // A group announce already owns the job and knows the total. A single
+        // file arriving on its own (a Drop push from the other side) has no
+        // announce, so its header starts the job and is its whole total.
+        if (!m_Job.active || m_Job.sending) {
+            jobStart(false, name, declared);
+        }
+        else if (m_Job.total <= 0) {
+            m_Job.total += declared;
+            m_Job.label = name;
+        }
+
+        conn->rxProgressMs = QDateTime::currentMSecsSinceEpoch();
+
+        conn->rxPath = dest;
+        conn->rxFile.setFileName(dest);
+        conn->rxGot = 0;
+
+        if (!conn->rxFile.open(QIODevice::WriteOnly)) {
+            log(QStringLiteral("  [!] ne mogu pisati %1").arg(dest));
+            conn->rxActive = false;
+
+            // The chunks that follow are still on the wire. Without a receiver
+            // they would be taken for "chunk without a file header", so the
+            // connection has to go.
+            conn->socket->abort();
+            return false;
+        }
+
+        conn->rxActive = true;
+
+        if (conn->groupActive) {
+            conn->groupPaths.append(dest);
+        }
+        break;
+    }
+
+    case kFrameFileChunk:
+    {
+        if (!conn->rxActive) {
+            log(QStringLiteral("  [!] komad bez najave datoteke"));
+            conn->socket->abort();
+            return false;
+        }
+
+        if (conn->rxFile.write(payload) != payload.size()) {
+            log(QStringLiteral("  [!] greska pri pisanju %1").arg(QFileInfo(conn->rxPath).fileName()));
+        }
+        conn->rxGot += payload.size();
+        conn->rxProgressMs = QDateTime::currentMSecsSinceEpoch();
+        jobAdvance(false, payload.size());
+        break;
+    }
+
+    case kFrameFileEnd:
+    {
+        if (conn->rxActive) {
+            if (conn->groupActive && conn->groupRemaining > 0) {
+                conn->groupRemaining--;
+            }
+            finishReceiving(conn);
+        }
+        break;
+    }
+
+    case kFrameHold:
+    {
+        // Nothing is on the wire any more, so the pause has nothing to stop -
+        // the whole file already went out. Only the tail of the job is owed
+        // (moving it out of Drop\, closing the bar), and skipping it here would
+        // leave both hanging until a resume that never comes.
+        if (!conn->txActive && conn->txQueue.isEmpty()) {
+            pumpSend(conn);
+            break;
+        }
+
+        // Logged once, not once per repeat: a peer that resends the hold must
+        // not fill the log.
+        if (!conn->txHeld) {
+            conn->txHeld = true;
+            conn->txHeldMs = QDateTime::currentMSecsSinceEpoch();
+
+            // The stamp is refreshed so the pause does not immediately look
+            // like a stall; checkStalls skips TX entirely while held anyway.
+            conn->txProgressMs = conn->txHeldMs;
+
+            QString koji = conn->txActive ? conn->txCurrent.name : QString();
+            if (koji.isEmpty()) {
+                const QJsonDocument doc = QJsonDocument::fromJson(payload);
+                koji = doc.isObject() ? doc.object().value(QStringLiteral("name")).toString() : QString();
+            }
+
+            // The bar is the only thing the user is looking at on this side,
+            // and it is what tells them to go and paste. Without the suffix a
+            // paused transfer and a wedged one look exactly the same.
+            if (m_Job.active && m_Job.sending) {
+                m_HoldLabelBase = m_Job.label;
+                m_Job.label = m_HoldLabelBase + QStringLiteral("  -  ceka se lijepljenje (Ctrl+V)");
+            }
+
+            log(QStringLiteral("  [.] %1: pauza - primalac ceka lijepljenje%2")
+                    .arg(conn->peer)
+                    .arg(koji.isEmpty() ? QString() : QStringLiteral(" (%1)").arg(koji)));
+        }
+        break;
+    }
+
+    case kFrameResume:
+    {
+        if (conn->txHeld) {
+            conn->txHeld = false;
+            const qint64 cekalo = conn->txHeldMs == 0 ? 0
+                                                      : (QDateTime::currentMSecsSinceEpoch() - conn->txHeldMs) / 1000;
+            conn->txHeldMs = 0;
+            conn->txProgressMs = QDateTime::currentMSecsSinceEpoch();
+
+            if (!m_HoldLabelBase.isEmpty()) {
+                m_Job.label = m_HoldLabelBase;
+                m_HoldLabelBase.clear();
+            }
+
+            log(QStringLiteral("  [.] %1: nastavljam (%2 s pauze)").arg(conn->peer).arg(cekalo));
+
+            // The chunks that were only not fed because of the pause go out
+            // now. Without this the transfer would sit here until the next
+            // bytesWritten, and that never comes because nothing was written.
+            pumpSend(conn);
+        }
+        break;
+    }
+
+    case kFrameAbandon:
+    {
+        // The far side gave up on the transfer it had asked us to pause, so
+        // nothing on the wire belongs to it any more. cancelSend drops the
+        // queued job too - see the note on kFrameAbandon.
+        const bool cekao = conn->txHeld;
+        cancelSend(conn);
+        log(QStringLiteral("  [.] %1: sugovornik je odustao - prijenos prekinut%2")
+                .arg(conn->peer)
+                .arg(cekao ? QStringLiteral(" (iz pauze)") : QString()));
+        break;
+    }
+
+    default:
+        log(QStringLiteral("  [!] nepoznat tip okvira %1").arg(type));
+        break;
+    }
+
+    return true;
+}
+
+void LuxBridge::finishReceiving(Connection* conn)
+{
+    if (!conn->rxActive) {
+        return;
+    }
+
+    conn->rxFile.close();
+    conn->rxActive = false;
+
+    log(QStringLiteral("  <- datoteka %1  (%2 B)")
+            .arg(QFileInfo(conn->rxPath).fileName()).arg(conn->rxGot));
+
+    if (conn->groupActive && conn->groupRemaining <= 0) {
+        applyClipboard(QString(), QByteArray(), conn->groupPaths);
+        log(QStringLiteral("  <- u meduspremnik stavljeno %1 datoteka").arg(conn->groupPaths.size()));
+        rememberCurrentClipboard();
+
+        conn->groupActive = false;
+        conn->groupPaths.clear();
+        jobFinish();
+    }
+    else if (!conn->groupActive) {
+        // A single file with no group around it (a Drop push). Nothing else is
+        // coming, so the job ends with it.
+        jobFinish();
+    }
+}
+
+void LuxBridge::sendFrame(Connection* conn, quint8 type, const QByteArray& payload)
+{
+    if (conn == nullptr || conn->socket == nullptr || conn->socket->state() != QAbstractSocket::ConnectedState) {
+        return;
+    }
+
+    QByteArray header;
+    header.reserve(5);
+    header.append(static_cast<char>(type));
+
+    const qint32 len = static_cast<qint32>(payload.size());
+    char lenBytes[4];
+    qToLittleEndian<qint32>(len, lenBytes);
+    header.append(lenBytes, 4);
+
+    conn->socket->write(header);
+    if (!payload.isEmpty()) {
+        conn->socket->write(payload);
+    }
+}
+
+// Najava jedne datoteke: ime, velicina i - samo za datoteke iz kopirane mape -
+// relativna putanja. Stariji sugovornik nepoznati kljuc ignorira i slozi
+// datoteku ravno; to je staro ponasanje, a ne greska.
+void LuxBridge::sendFileHeader(Connection* conn, const TxItem& item)
+{
+    QJsonObject header;
+    header.insert(QStringLiteral("name"), item.name);
+    header.insert(QStringLiteral("size"), static_cast<double>(item.size));
+    if (!item.rel.isEmpty()) {
+        header.insert(QStringLiteral("rel"), item.rel);
+    }
+    sendFrame(conn, kFrameFileHeader, QJsonDocument(header).toJson(QJsonDocument::Compact));
+}
+
+bool LuxBridge::queueFile(Connection* conn, TxItem item)
+{
+    if (conn == nullptr) {
+        return false;
+    }
+
+    const QFileInfo fi(item.path);
+    if (!fi.exists() || !fi.isFile()) {
+        log(QStringLiteral("  [!] %1: nema datoteke").arg(fi.fileName()));
+        return false;
+    }
+
+    if (kDropFileMaxBytes > 0 && fi.size() > kDropFileMaxBytes) {
+        log(QStringLiteral("  [!] %1: prevelika (%2 MB > %3 MB)")
+                .arg(fi.fileName())
+                .arg(QString::number(fi.size() / 1048576.0, 'f', 1))
+                .arg(kDropFileMaxBytes / 1048576));
+        return false;
+    }
+
+    item.name = fi.fileName();
+    item.size = fi.size();
+
+    // Everything queued while a transfer is already running is added to that
+    // same job, so a clipboard group and a Drop file that rides along end up on
+    // one progress bar instead of fighting over it.
+    if (m_Job.active) {
+        jobExtend(true, item.name, item.size);
+    }
+    else {
+        jobStart(true, item.name, item.size);
+    }
+
+    conn->txQueue.enqueue(item);
+
+    // The group counters are set by the caller, before the first file of the
+    // group is queued - see pollClipboard. Counting here would not work:
+    // pumpSend below sends a small file inside this same call, so a group
+    // counted file by file drops back to zero between them and every file
+    // gets its own summary line ("1 datoteka", "2 datoteka", ...) instead of
+    // one line for the whole group.
+
+    pumpSend(conn);
+    return true;
+}
+
+void LuxBridge::pumpSend(Connection* conn)
+{
+    if (conn == nullptr || conn->txBusy) {
+        return;
+    }
+
+    conn->txBusy = true;
+
+    // Held by the far side until its user pastes (kFrameHold). Filling the
+    // socket from here would push the file into the send buffer anyway, and a
+    // 4 MB head start is exactly what the hold frame exists to avoid - the file
+    // must not grow on the other side before the paste happens.
+    if (conn->txHeld) {
+        conn->txBusy = false;
+        return;
+    }
+
+    while (conn->socket != nullptr && conn->socket->state() == QAbstractSocket::ConnectedState) {
+        if (!conn->txActive) {
+            if (conn->txQueue.isEmpty()) {
+                break;
+            }
+
+            const TxItem item = conn->txQueue.dequeue();
+            conn->txCurrent = item;
+            conn->txSent = 0;
+
+            // Zaglavlje grupe iz meduspremnika je vec poslano - vidi
+            // pollClipboard. Za sve ostalo (Drop, pojedinacna datoteka) ide
+            // ovdje, neposredno prije prvog komada.
+            if (!item.headerSent) {
+                sendFileHeader(conn, item);
+            }
+
+            conn->txFile.setFileName(item.path);
+            if (!conn->txFile.open(QIODevice::ReadOnly)) {
+                log(QStringLiteral("  [!] %1: ne mogu citati").arg(item.name));
+                conn->txActive = false;
+                if (!item.dropKey.isEmpty()) {
+                    m_SentDropKeys.remove(item.dropKey);
+                }
+                // The header is already gone. Closing the connection is the
+                // only way the other side ever learns this file is not coming.
+                conn->socket->abort();
+                break;
+            }
+
+            conn->txActive = true;
+            conn->txProgressMs = QDateTime::currentMSecsSinceEpoch();
+        }
+
+        // Flow control: without it a multi-gigabyte file would pile up in Qt's
+        // write buffer and take the whole app down with it. Stopping here only
+        // stops *filling* the buffer - the event loop runs the whole time and
+        // bytesWritten brings us back for the next chunks. The old code called
+        // waitForBytesWritten(30000) here instead, which pumped socket events
+        // only and left the window and the clipboard poll frozen for as long as
+        // the transfer lasted.
+        if (conn->socket->bytesToWrite() >= kSendBufferHighWater) {
+            break;
+        }
+
+        const QByteArray chunk = conn->txFile.read(kChunkBytes);
+        if (chunk.isEmpty()) {
+            finishCurrentSend(conn);
+            continue;   // the next queued file, if there is one
+        }
+
+        sendFrame(conn, kFrameFileChunk, chunk);
+        conn->txSent += chunk.size();
+        conn->txProgressMs = QDateTime::currentMSecsSinceEpoch();
+        jobAdvance(true, chunk.size());
+    }
+
+    // A Drop file may only leave Drop\ once its tail has really gone out, not
+    // when the last chunk was merely handed to the socket. Everything queued
+    // and buffered is done, so the moves are safe now.
+    if (!conn->txActive && conn->txQueue.isEmpty() && !conn->txMoves.isEmpty()
+            && conn->socket != nullptr && conn->socket->bytesToWrite() == 0) {
+        for (const TxItem& item : conn->txMoves) {
+            if (!QFile::rename(item.path, item.moveAfterTo)) {
+                log(QStringLiteral("  [!] Drop: ne mogu premjestiti %1").arg(item.name));
+            }
+        }
+        conn->txMoves.clear();
+    }
+
+    // Nothing is queued and the socket buffer is empty, so this side is done
+    // with the transfer. That is the end of the job, whatever it was made of -
+    // one big file, a whole clipboard group, or a Drop file that rode along.
+    if (!conn->txActive && conn->txQueue.isEmpty() && m_Job.active && m_Job.sending
+            && conn->socket != nullptr && conn->socket->bytesToWrite() == 0) {
+        jobFinish();
+    }
+
+    conn->txBusy = false;
+}
+
+void LuxBridge::finishCurrentSend(Connection* conn)
+{
+    const TxItem item = conn->txCurrent;
+
+    sendFrame(conn, kFrameFileEnd, QByteArray());
+    conn->txFile.close();
+    conn->txActive = false;
+    conn->txCurrent = TxItem();
+
+    // A file that leaves Drop\ is a file that has been delivered; keeping it
+    // would mean sending it again after every restart. The move itself waits
+    // for the socket to drain - see pumpSend.
+    if (!item.moveAfterTo.isEmpty()) {
+        conn->txMoves.append(item);
+    }
+
+    if (item.fromClipboard) {
+        conn->grpLeft--;
+        if (conn->grpLeft <= 0) {
+            log(QStringLiteral("  -> u meduspremnik poslano %1 datoteka (%2 MB)")
+                    .arg(conn->grpCount)
+                    .arg(QString::number(conn->grpBytes / 1048576.0, 'f', 1)));
+        }
+    }
+}
+
+// A transfer "job" is whatever is on the wire right now, in one direction. It
+// is counted from the bytes that really move, so the window and the log never
+// disagree, and it is deliberately not tied to a clipboard group: a queued Drop
+// file rides along on the same job instead of resetting it.
+void LuxBridge::jobStart(bool sending, const QString& label, qint64 bytes)
+{
+    m_Job.active = true;
+    m_Job.sending = sending;
+    m_Job.label = label;
+    m_Job.total = bytes;
+    m_Job.done = 0;
+    m_Job.startMs = QDateTime::currentMSecsSinceEpoch();
+    m_Job.lastMs = m_Job.startMs;
+    m_Job.lastDone = 0;
+    m_Job.speed = 0;
+    m_Job.endMs = 0;
+    m_Job.lastPaintMs = 0;
+    m_Job.shown = false;
+}
+
+void LuxBridge::jobExtend(bool sending, const QString& label, qint64 bytes)
+{
+    // A transfer in the other direction owns the window; counting this one into
+    // it would make the numbers nonsense.
+    if (!m_Job.active || m_Job.sending != sending) {
+        return;
+    }
+
+    m_Job.total += bytes;
+    if (!label.isEmpty()) {
+        m_Job.label = label;
+    }
+}
+
+void LuxBridge::jobAdvance(bool sending, qint64 bytes)
+{
+    if (!m_Job.active || m_Job.endMs != 0 || m_Job.sending != sending) {
+        return;
+    }
+
+    m_Job.done += bytes;
+
+    const qint64 now = QDateTime::currentMSecsSinceEpoch();
+    if (now - m_Job.lastMs >= 400) {
+        const double dt = (now - m_Job.lastMs) / 1000.0;
+        if (dt > 0.0) {
+            m_Job.speed = static_cast<qint64>((m_Job.done - m_Job.lastDone) / dt);
+        }
+        m_Job.lastMs = now;
+        m_Job.lastDone = m_Job.done;
+    }
+
+    jobTick();
+}
+
+void LuxBridge::jobFinish()
+{
+    if (!m_Job.active) {
+        return;
+    }
+
+    // A job that was aborted while the far side held it would otherwise keep
+    // the "ceka se lijepljenje" hint on a bar that is already counting down.
+    if (!m_HoldLabelBase.isEmpty()) {
+        m_Job.label = m_HoldLabelBase;
+        m_HoldLabelBase.clear();
+    }
+
+    m_Job.active = false;
+    m_Job.endMs = QDateTime::currentMSecsSinceEpoch();
+    m_Job.lastPaintMs = 0;      // the final 100% is drawn immediately
+    jobTick();
+}
+
+void LuxBridge::jobTick()
+{
+    if (!m_Job.active && m_Job.endMs == 0) {
+        return;
+    }
+
+    const qint64 now = QDateTime::currentMSecsSinceEpoch();
+
+    if (m_Job.active) {
+        if (!m_Job.shown) {
+            // A copy that is over before the eye reaches it is not worth a
+            // window, so it only appears for a transfer of some size that is
+            // also still running after the delay.
+            if (m_Job.total < kProgressMinBytes || now - m_Job.startMs < kProgressShowDelayMs) {
+                return;
+            }
+            luxProgressShow(m_Job.sending ? QStringLiteral("Luxstream - saljem")
+                                          : QStringLiteral("Luxstream - primam"),
+                            m_Job.label);
+            m_Job.shown = true;
+            m_Job.lastPaintMs = 0;
+        }
+
+        if (now - m_Job.lastPaintMs < kProgressPaintMs) {
+            return;
+        }
+        m_Job.lastPaintMs = now;
+        luxProgressUpdate(m_Job.total, m_Job.done, m_Job.speed, false, m_Job.label);
+        return;
+    }
+
+    // Finished. The window stays up for a moment so the 100% is actually seen
+    // instead of vanishing the instant the last byte lands.
+    if (!m_Job.shown) {
+        m_Job.endMs = 0;
+        return;
+    }
+
+    if (now - m_Job.endMs < kProgressKeepMs) {
+        if (now - m_Job.lastPaintMs < kProgressPaintMs) {
+            return;
+        }
+        m_Job.lastPaintMs = now;
+        luxProgressUpdate(m_Job.total, m_Job.done, m_Job.speed, true, m_Job.label);
+        return;
+    }
+
+    luxProgressHide();
+    m_Job.shown = false;
+    m_Job.endMs = 0;
+}
+
+LuxBridge::Connection* LuxBridge::firstLiveConnection() const
+{
+    for (auto it = m_Connections.constBegin(); it != m_Connections.constEnd(); ++it) {
+        if (it.value()->greeted && it.value()->socket->state() == QAbstractSocket::ConnectedState) {
+            return it.value();
+        }
+    }
+    return nullptr;
+}
+
+void LuxBridge::onPoll()
+{
+    // Both of these have to run even with nothing connected: the first may
+    // discover that a connection only looks alive, the second still has to
+    // take the progress window down after a transfer that just ended.
+    checkStalls();
+    jobTick();
+
+    Connection* conn = firstLiveConnection();
+    if (conn == nullptr) {
+        return;
+    }
+
+    pollClipboard();
+    pollDropFolder();
+}
+
+LuxBridge::ClipKind LuxBridge::readClipboard(QString* text, QByteArray* png, QStringList* files) const
+{
+    const QClipboard* clipboard = QGuiApplication::clipboard();
+    const QMimeData* mime = clipboard != nullptr ? clipboard->mimeData() : nullptr;
+
+    if (mime != nullptr && mime->hasUrls()) {
+        QStringList local;
+        for (const QUrl& url : mime->urls()) {
+            if (!url.isLocalFile()) {
+                continue;
+            }
+            const QString path = url.toLocalFile();
+            QFileInfo fi(path);
+            // Folders are taken as well now. They are not sent as such - a
+            // folder is expanded later, in expandPaths, into the files it
+            // holds. Dropping them here is what made copying a folder look
+            // like nothing happened at all.
+            if (fi.exists()) {
+                local.append(QDir::toNativeSeparators(path));
+            }
+        }
+        if (!local.isEmpty()) {
+            if (files != nullptr) {
+                *files = local;
+            }
+            return ClipKind::Files;
+        }
+    }
+
+    if (mime != nullptr && mime->hasText()) {
+        const QString t = clipboard->text();
+        if (!t.isEmpty()) {
+            if (text != nullptr) {
+                *text = t;
+            }
+            return ClipKind::Text;
+        }
+    }
+
+    const QImage img = clipboard != nullptr ? clipboard->image() : QImage();
+    if (!img.isNull()) {
+        QByteArray data;
+        QBuffer buffer(&data);
+        buffer.open(QIODevice::WriteOnly);
+        if (img.save(&buffer, "PNG")) {
+            buffer.close();
+            if (png != nullptr) {
+                *png = data;
+            }
+            return ClipKind::Image;
+        }
+    }
+
+    return ClipKind::None;
+}
+
+void LuxBridge::applyClipboard(const QString& text, const QByteArray& png, const QStringList& files)
+{
+    QClipboard* clipboard = QGuiApplication::clipboard();
+    if (clipboard == nullptr) {
+        return;
+    }
+
+    // What this call intends to put on the clipboard. rememberCurrentClipboard
+    // re-reads instead of trusting this, because a PNG does not always come
+    // back byte-identical - but if the re-read comes back empty (another
+    // process held the clipboard) the hash below is what saves the bridge from
+    // taking the other side's own content for a fresh change and bouncing it
+    // straight back.
+    m_AppliedHash = hashOf(!files.isEmpty() ? ClipKind::Files
+                                            : (!png.isEmpty() ? ClipKind::Image
+                                                              : (!text.isEmpty() ? ClipKind::Text
+                                                                                 : ClipKind::None)),
+                           text, png, files);
+
+    if (!files.isEmpty()) {
+        QMimeData* mime = new QMimeData();
+        QList<QUrl> urls;
+        for (const QString& path : files) {
+            urls.append(QUrl::fromLocalFile(path));
+        }
+        mime->setUrls(urls);
+        clipboard->setMimeData(mime);
+        return;
+    }
+
+    if (!png.isEmpty()) {
+        const QImage img = QImage::fromData(png, "PNG");
+        if (!img.isNull()) {
+            clipboard->setImage(img);
+        }
+        return;
+    }
+
+    if (!text.isEmpty()) {
+        clipboard->setText(text);
+    }
+}
+
+QString LuxBridge::hashOf(ClipKind kind, const QString& text, const QByteArray& png,
+                          const QStringList& files) const
+{
+    switch (kind) {
+    case ClipKind::Text:
+        return QStringLiteral("T") + md5hex(text.toUtf8());
+    case ClipKind::Image:
+        return QStringLiteral("I") + md5hex(png.toBase64());
+    case ClipKind::Files:
+    {
+        QStringList sorted = files;
+        sorted.sort();
+        return QStringLiteral("F") + md5hex(sorted.join(QLatin1Char('|')).toUtf8());
+    }
+    default:
+        return QStringLiteral("N");
+    }
+}
+
+void LuxBridge::rememberCurrentClipboard()
+{
+    QString text;
+    QByteArray png;
+    QStringList files;
+    const ClipKind kind = readClipboard(&text, &png, &files);
+
+    const QString hash = hashOf(kind, text, png, files);
+
+    if (hash == QStringLiteral("N") && !m_AppliedHash.isEmpty()) {
+        // The clipboard did not hand back what was just put there. Storing "N"
+        // would leave m_LastHash describing nothing, so the next poll would
+        // read the other side's content, find it different, and send it back.
+        m_LastHash = m_AppliedHash;
+    }
+    else {
+        m_LastHash = hash;
+        m_AppliedHash = hash;
+    }
+
+    // One poll interval. The window only has to cover the clipboard settling
+    // after it was written; anything longer silently swallows copies the user
+    // makes in the meantime, and two copies inside it meant the first was never
+    // sent at all.
+    m_SkipUntilMs = QDateTime::currentMSecsSinceEpoch() + kPollMs;
+}
+
+// Drops everything this connection still had queued to send, lifts the pause
+// and closes the job. Called when the transfer is known to be pointless: the
+// far side said so (kFrameAbandon), or the clipboard did (see pollClipboard).
+//
+// Only TX state is touched. What already went into the socket stays there -
+// the receiver discards frames for a group it has abandoned, and lifting bytes
+// back out of a QTcpSocket is not something the API offers anyway.
+void LuxBridge::cancelSend(Connection* conn)
+{
+    if (conn == nullptr) {
+        return;
+    }
+
+    conn->txHeld = false;
+    conn->txHeldMs = 0;
+    conn->txProgressMs = QDateTime::currentMSecsSinceEpoch();
+
+    if (conn->txActive) {
+        conn->txFile.close();
+        conn->txActive = false;
+    }
+    conn->txQueue.clear();
+    conn->txCurrent = TxItem();
+    conn->txSent = 0;
+
+    // The group summary ("poslano N datoteka") must not fire for a group that
+    // was cancelled, so its counters go with the queue.
+    conn->grpLeft = 0;
+    conn->grpCount = 0;
+    conn->grpBytes = 0;
+
+    jobFinish();
+}
+
+void LuxBridge::pollClipboard()
+{
+    if (QDateTime::currentMSecsSinceEpoch() < m_SkipUntilMs) {
+        return;
+    }
+
+    QString text;
+    QByteArray png;
+    QStringList files;
+    const ClipKind kind = readClipboard(&text, &png, &files);
+
+    const QString hash = hashOf(kind, text, png, files);
+    if (hash == m_LastHash || hash == QStringLiteral("N")) {
+        return;
+    }
+
+    Connection* conn = firstLiveConnection();
+    if (conn == nullptr) {
+        return;
+    }
+
+    // While the far side waits for its user to paste, its clipboard holds the
+    // file group we are feeding. Pushing another clipboard content now would
+    // take that clipboard away mid-paste - but only for as long as the pause
+    // still makes sense.
+    //
+    // Text and images are the exception, and they are what this branch is here
+    // for. The pause may run for ten minutes, and for all of it the far side's
+    // bridge stops polling its own clipboard as well, so a plain text copy
+    // froze in BOTH directions (seen 01.11.2026.: two full 10-minute windows in
+    // which copying text simply did nothing, and every reconnect re-announced
+    // the same file because it was still on this clipboard).
+    //
+    // A text or an image on THIS clipboard therefore means the user moved on:
+    // the queued job is cancelled, kFrameAbandon tells the far side to drop its
+    // descriptor too, and the new content goes out below. Any other kind - in
+    // particular a fresh file copy - leaves the pause alone, and m_LastHash
+    // stays unconsumed so it travels once the transfer resumes.
+    if (conn->txHeld) {
+        if (kind == ClipKind::Text || kind == ClipKind::Image) {
+            cancelSend(conn);
+            sendFrame(conn, kFrameAbandon, QByteArray());
+            log(QStringLiteral("  [.] %1: kopirano je nesto drugo - napustam prijenos").arg(conn->peer));
+        }
+        else {
+            return;
+        }
+    }
+
+    switch (kind) {
+    case ClipKind::Text:
+        if (text.toUtf8().size() <= kMaxTextBytes) {
+            sendFrame(conn, kFrameText, text.toUtf8());
+            m_LastHash = hash;
+
+            QString preview = text.left(40);
+            if (text.length() > 40) {
+                preview += QStringLiteral("...");
+            }
+            preview.replace(QLatin1Char('\r'), QLatin1Char(' '));
+            preview.replace(QLatin1Char('\n'), QLatin1Char(' '));
+            log(QStringLiteral("  -> tekst %1 B  %2").arg(text.toUtf8().size()).arg(preview));
+        }
+        break;
+
+    case ClipKind::Image:
+        if (png.size() <= kMaxImageBytes) {
+            sendFrame(conn, kFrameImage, png);
+            m_LastHash = hash;
+            log(QStringLiteral("  -> slika %1 B").arg(png.size()));
+        }
+        break;
+
+    case ClipKind::Files:
+    {
+        // The clipboard may hold folders as well as files; only the expanded
+        // list is what actually travels.
+        const QVector<QPair<QString, QString>> items = expandPaths(files);
+
+        qint64 total = 0;
+        for (const QPair<QString, QString>& e : items) {
+            total += QFileInfo(e.first).size();
+        }
+
+        m_LastHash = hash;
+
+        if (kClipFileMaxBytes <= 0 || total <= kClipFileMaxBytes) {
+            QJsonObject announce;
+            announce.insert(QStringLiteral("count"), items.size());
+            announce.insert(QStringLiteral("ukupno"), static_cast<double>(total));
+            sendFrame(conn, kFrameClipGroup, QJsonDocument(announce).toJson(QJsonDocument::Compact));
+
+            // The accounting is per group, and a group that is still on the wire
+            // is added to rather than replaced, so one summary line covers both.
+            // It has to be done BEFORE the first file is queued: queueFile sends
+            // a small file inside the same call, so a group counted file by file
+            // goes back to zero between them and every file would get its own
+            // summary line instead of one for the group.
+            if (conn->grpLeft <= 0) {
+                conn->grpCount = 0;
+                conn->grpBytes = 0;
+                conn->grpLeft = 0;
+            }
+
+            int spremno = 0;
+            qint64 spremnoBajtova = 0;
+            QVector<TxItem> spremni;
+            for (const QPair<QString, QString>& e : items) {
+                const QFileInfo fi(e.first);
+                if (fi.exists() && fi.isFile()) {
+                    TxItem item;
+                    item.path = e.first;
+                    item.rel = e.second;
+                    item.name = fi.fileName();
+                    item.size = fi.size();
+                    item.fromClipboard = true;
+                    spremni.append(item);
+                    spremno++;
+                    spremnoBajtova += fi.size();
+                }
+            }
+            conn->grpCount += spremno;
+            conn->grpLeft += spremno;
+            conn->grpBytes += spremnoBajtova;
+
+            // Zaglavlja CIJELE grupe idu prva, sva jedno za drugim, prije
+            // ijednog bajta podataka. Druga strana iz njih sastavlja opisnik
+            // meduspremnika (FileGroupDescriptorW) i mora ga imati cijelog
+            // prije nego korisnik stisne Ctrl+V. Da zaglavlja idu isprepletena
+            // s podacima - kako pumpSend inace radi - korisnik bi mogao
+            // zalijepiti tek kad su sve datoteke osim zadnje vec poslane; kod
+            // kopirane mape s tisucama datoteka to je cijeli prijenos.
+            for (const TxItem& item : spremni) {
+                sendFileHeader(conn, item);
+            }
+
+            int queued = 0;
+            for (TxItem item : spremni) {
+                item.headerSent = true;
+                if (queueFile(conn, item)) {
+                    queued++;
+                }
+            }
+
+            // A file that was counted but then refused (gone by the time we got
+            // to it, or over the cap) would otherwise hold grpLeft above zero
+            // and swallow the summary line of the whole group.
+            if (queued < spremno) {
+                conn->grpLeft -= (spremno - queued);
+                conn->grpCount -= (spremno - queued);
+            }
+
+            // The summary itself is written by finishCurrentSend, once the last
+            // file of the group has really gone out - a whole group of small
+            // files can even finish inside queueFile itself. Only the "nothing
+            // to send" case has no file to write it from.
+            if (queued == 0) {
+                log(QStringLiteral("  -> u meduspremnik poslano 0 datoteka (%1 MB)")
+                        .arg(QString::number(total / 1048576.0, 'f', 1)));
+            }
+        }
+        else {
+            log(QStringLiteral("  [!] kopirano %1 MB > %2 MB - preskacem; koristi mapu Drop")
+                    .arg(QString::number(total / 1048576.0, 'f', 1))
+                    .arg(kClipFileMaxBytes / 1048576));
+        }
+        break;
+    }
+
+    default:
+        break;
+    }
+}
+
+void LuxBridge::pollDropFolder()
+{
+    QDir dropDir(m_DropDir);
+    if (!dropDir.exists()) {
+        return;
+    }
+
+    const QFileInfoList entries = dropDir.entryInfoList(QDir::Files, QDir::Name);
+    if (entries.isEmpty()) {
+        return;
+    }
+
+    Connection* conn = firstLiveConnection();
+    if (conn == nullptr) {
+        return;
+    }
+
+    const QDateTime cutOff = QDateTime::currentDateTimeUtc().addSecs(-1);
+
+    for (const QFileInfo& fi : entries) {
+        const QString key = fi.fileName()
+                + QLatin1Char('|') + QString::number(fi.size())
+                + QLatin1Char('|') + QString::number(fi.lastModified().toUTC().toMSecsSinceEpoch());
+
+        if (m_SentDropKeys.contains(key)) {
+            continue;
+        }
+
+        // Still being copied in. Sending now would ship a truncated file.
+        if (fi.lastModified().toUTC() > cutOff) {
+            continue;
+        }
+
+        m_SentDropKeys.insert(key, true);
+
+        log(QStringLiteral("  -> Drop: %1 (%2 B)").arg(fi.fileName()).arg(fi.size()));
+
+        // The move to Poslano\ happens in finishCurrentSend, after the last
+        // chunk: the file may no longer leave Drop\ until it is really gone.
+        TxItem item;
+        item.path = fi.absoluteFilePath();
+        item.rel = fi.fileName();
+        item.moveAfterTo = reserveName(m_SentDir, fi.fileName());
+        item.dropKey = key;
+        queueFile(conn, item);
+    }
+}
+
+QVector<QPair<QString, QString>> LuxBridge::expandPaths(const QStringList& items)
+{
+    QVector<QPair<QString, QString>> out;
+    QSet<QString> seen;
+
+    for (const QString& item : items) {
+        const QFileInfo fi(item);
+        if (!fi.exists()) {
+            continue;
+        }
+
+        if (fi.isDir()) {
+            // A folder is walked recursively and its own name becomes the first
+            // path segment, so the other side rebuilds "<folder>\..." instead of
+            // spilling the contents loose. Junctions are skipped: Windows is
+            // full of them (every "Application Data" is one), and following them
+            // both duplicates files and can loop forever.
+            const QString root = fi.absoluteFilePath();
+            const QString base = fi.fileName();
+            QDirIterator it(root, QDir::Files | QDir::NoSymLinks, QDirIterator::Subdirectories);
+            while (it.hasNext()) {
+                it.next();
+                QString rel = base + QLatin1Char('/')
+                        + QDir(root).relativeFilePath(it.fileInfo().absoluteFilePath());
+                rel.replace(QLatin1Char('\\'), QLatin1Char('/'));
+                if (seen.contains(rel)) {
+                    continue;
+                }
+                seen.insert(rel);
+                out.append(qMakePair(it.fileInfo().absoluteFilePath(), rel));
+            }
+            continue;
+        }
+
+        const QString rel = fi.fileName();
+        if (seen.contains(rel)) {
+            continue;
+        }
+        seen.insert(rel);
+        out.append(qMakePair(fi.absoluteFilePath(), rel));
+    }
+
+    return out;
+}
+
+QString LuxBridge::destForRel(const QString& rel, const QString& fallbackName)
+{
+    QStringList segments;
+    const QStringList raw = rel.split(QLatin1Char('/'), Qt::SkipEmptyParts);
+    for (const QString& part : raw) {
+        // Each segment goes through the same sanitiser as a plain file name, so
+        // a hostile "..\..\Windows" cannot climb out of Primljeno\.
+        const QString cleaned = sanitizeName(part);
+        if (!cleaned.isEmpty()) {
+            segments.append(cleaned);
+        }
+    }
+
+    if (segments.isEmpty()) {
+        return freeName(m_ReceivedDir, sanitizeName(fallbackName));
+    }
+
+    QDir dir(m_ReceivedDir);
+    for (int i = 0; i + 1 < segments.size(); i++) {
+        if (!dir.mkpath(segments.at(i))) {
+            // Somewhere up the tree is not writable. Dropping the file flat
+            // loses the structure but not the file itself.
+            return freeName(m_ReceivedDir, sanitizeName(fallbackName));
+        }
+        dir.cd(segments.at(i));
+    }
+
+    return freeName(dir.absolutePath(), segments.last());
+}
+
+QString LuxBridge::sanitizeName(const QString& name)
+{
+    QString n = name;
+    if (n.trimmed().isEmpty()) {
+        return QStringLiteral("datoteka");
+    }
+
+    // Discard any path the other side may have sent
+    const int slash = qMax(n.lastIndexOf(QLatin1Char('/')), n.lastIndexOf(QLatin1Char('\\')));
+    if (slash >= 0) {
+        n = n.mid(slash + 1);
+    }
+
+    // Replace what Windows does not allow in a file name
+    QString out;
+    out.reserve(n.size());
+    for (const QChar c : n) {
+        const ushort u = c.unicode();
+        if (u < 0x20 || c == QLatin1Char('<') || c == QLatin1Char('>') || c == QLatin1Char(':') ||
+                c == QLatin1Char('"') || c == QLatin1Char('|') || c == QLatin1Char('?') || c == QLatin1Char('*')) {
+            out.append(QLatin1Char('_'));
+        }
+        else {
+            out.append(c);
+        }
+    }
+
+    while (!out.isEmpty() && (out.endsWith(QLatin1Char(' ')) || out.endsWith(QLatin1Char('.')))) {
+        out.chop(1);
+    }
+    while (!out.isEmpty() && out.startsWith(QLatin1Char(' '))) {
+        out.remove(0, 1);
+    }
+
+    if (out.isEmpty() || out == QStringLiteral(".") || out == QStringLiteral("..")) {
+        return QStringLiteral("datoteka");
+    }
+
+    if (out.length() > 180) {
+        out.truncate(180);
+    }
+
+    return out;
+}
+
+QString LuxBridge::freeName(const QString& dir, const QString& name)
+{
+    const QString path = QDir(dir).filePath(name);
+    if (!QFileInfo::exists(path)) {
+        return path;
+    }
+
+    const QFileInfo fi(name);
+    const QString base = fi.completeBaseName().isEmpty() ? name : fi.completeBaseName();
+    const QString suffix = fi.suffix().isEmpty() ? QString() : QStringLiteral(".") + fi.suffix();
+
+    for (int i = 1; i < 10000; i++) {
+        const QString candidate = QDir(dir).filePath(QStringLiteral("%1-%2%3").arg(base).arg(i).arg(suffix));
+        if (!QFileInfo::exists(candidate)) {
+            return candidate;
+        }
+    }
+
+    return QDir(dir).filePath(QDateTime::currentDateTime().toString("HHmmss") + QLatin1Char('-') + name);
+}
+
+QString LuxBridge::reserveName(const QString& dir, const QString& name)
+{
+    QString path = freeName(dir, name);
+
+    // freeName only knows what is already on the disk. A whole poll tick can
+    // now queue several files at once and none of them has been moved yet, so
+    // two of them would be handed the same destination and one would overwrite
+    // the other. m_ReservedDests remembers what is already promised.
+    const QFileInfo fi(name);
+    const QString base = fi.completeBaseName().isEmpty() ? name : fi.completeBaseName();
+    const QString suffix = fi.suffix().isEmpty() ? QString() : QStringLiteral(".") + fi.suffix();
+
+    for (int i = 1; m_ReservedDests.contains(path) && i < 10000; i++) {
+        path = QDir(dir).filePath(QStringLiteral("%1-%2%3").arg(base).arg(i).arg(suffix));
+    }
+
+    m_ReservedDests.insert(path);
+    return path;
+}
+
+QString LuxBridge::md5hex(const QByteArray& data)
+{
+    return QString::fromLatin1(QCryptographicHash::hash(data, QCryptographicHash::Md5).toHex());
+}
