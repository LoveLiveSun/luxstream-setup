+    // is never reported as closed - so the bridge would end up holding two
+    // connections to one machine and firstLiveConnection() would pick between
+    // them at random. The newest one is the one that works.
+    void dropStalePeers(Connection* keep);
+
+    Connection* firstLiveConnection() const;
+
+    // What the progress window is currently showing. Bytes are counted as they
+    // really move, so the window and the log tell the same story. Only one
+    // transfer is on screen at a time; whatever starts last owns it.
+    struct Job
+    {
+        bool active = false;
+        bool sending = true;
+        QString label;
+        qint64 total = 0;
+        qint64 done = 0;
+        qint64 startMs = 0;
+        qint64 lastMs = 0;
+        qint64 lastDone = 0;
