+    void cancelSend(Connection* conn);
+
+    void pollClipboard();
+    void pollDropFolder();
+
+    // Aborts a connection whose socket has stopped moving bytes in either
+    // direction. This is the host-side counterpart of Test-Veza in the
+    // PowerShell half: there, a closed socket stayed "Connected"; here, a
+    // socket whose far end vanished stays "Connected" because no FIN ever
+    // arrives. Both have to be noticed by hand or the pair wedges.
+    void checkStalls();
