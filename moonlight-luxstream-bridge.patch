+QT_BEGIN_NAMESPACE
+class QHostAddress;
+class QTcpServer;
+class QTcpSocket;
+QT_END_NAMESPACE
+
+// Luxstream bridge: clipboard and file transfer between this machine and the
+// other half of the pair.
+//
+// Why it exists at all: Sunshine and Moonlight share neither the clipboard nor
+// files. That is not a missing setting - the streaming protocol has no such
+// feature (Sunshine carries only video, audio and input). The bridge therefore
+// runs over plain TCP, entirely outside the stream protocol, so it keeps
+// working with any Sunshine and Moonlight version.
+//
+// This side is the SERVER. The reason is the address: on the Default Switch the
+// host keeps a fixed address while the VM's address changes (DHCP, clones), so
+// a client in the VM would otherwise have to be reconfigured. The other half is
+// luxstream-bridge.ps1 -Mode Client, which without -Peer picks the default
+// gateway - and on the Default Switch that gateway is exactly this machine.
+//
+// Because this lives inside Moonlight instead of in a scheduled task, the
+// clipboard is reached through Qt on the main thread. That removes the whole
+// reason the PowerShell half needed a permanent STA runspace: the Windows
+// clipboard API silently does nothing from an MTA thread, so a naive bridge
+// works when started by hand and stops working when started by Task Scheduler.
+//
+// Port 51888, config C:\ProgramData\Luxstream\bridge.json, log in
+// %USERPROFILE%\Luxstream\luxstream-bridge.log, folders Drop\ and Primljeno\.
+//
+// The wire format matches luxstream-bridge.ps1 exactly:
+//   [1 byte type][4 byte little-endian payload length][payload]
+//     0x01 greeting (JSON {v,secret})   0x02 greeting reply ("OK"/"NO")
+//     0x10 clipboard text (UTF-8)       0x11 clipboard image (PNG)
+//     0x12 clipboard file group (JSON {count,ukupno})
+//     0x20 file header (JSON {name,size,rel?} - "rel" only when the file came
+//          out of a copied folder, so the same tree can be rebuilt)
+//     0x21 file chunk                   0x22 file end
+//     0x30 hold   (JSON {name,size})    0x31 resume
+//          Receiver to sender. 0x30 says "stop sending me this file, my user
+//          has not pasted yet", 0x31 says "go on". Both are ignored by an
+//          older peer, which simply keeps streaming.
+class LuxBridge : public QObject
+{
+    Q_OBJECT
+
+public:
+    // Reads the configuration and starts listening. Returns nullptr when there
+    // is nothing to start with (no config, no secret, port taken) - in that
+    // case the reason is written to the bridge log.
+    static LuxBridge* start();
+
+    ~LuxBridge() override;
+
+    bool isListening() const;
+
+    // The listener is dual stack, so an IPv4 client arrives as an IPv4-mapped
+    // IPv6 address ("::ffff:127.0.0.1") that matches none of the IPv4 prefixes
+    // in the allow list. This reduces it back to dotted IPv4 before anything
+    // looks at it. Public only so the smoke test can reason about it.
+    static QString canonicalPeer(const QHostAddress& address);
+
+private slots:
+    void onNewConnection();
+    void onReadyRead();
+    void onBytesWritten(qint64 bytes);
+    void onDisconnected();
+    void onPoll();
+
+private:
+    explicit LuxBridge(QObject* parent = nullptr);
+
+    bool begin();
+    void ensureFolders();
+    void log(const QString& message);
+
+    // One file waiting to go out. Sending used to be a plain loop on the GUI
+    // thread, so a single 4.6 GB file held Moonlight's event loop for around a
+    // hundred seconds: the window froze, and the clipboard poll - which shares
+    // that thread - never saw anything the user copied while it ran. The queue
+    // below is fed to the socket from bytesWritten instead; see pumpSend.
+    struct TxItem
+    {
+        QString path;
+        QString name;
+        QString rel;
+        qint64 size = 0;
+
+        // When not empty, the file is moved here once it has fully gone out.
+        // The Drop folder is the only user: there "sent" has to mean "may leave
+        // Drop\" as well, so the move cannot happen before the last chunk.
+        QString moveAfterTo;
+
+        // The Drop bookkeeping key, kept so it can be released again when a
+        // file never actually makes it out.
+        QString dropKey;
+
+        // Files that came out of a copied clipboard group are counted, so the
+        // group summary is logged once, when the last of them is on the wire.
+        bool fromClipboard = false;
+
+        // Postavlja se kad je zaglavlje ove datoteke vec poslano izvan
+        // pumpSend-a - vidi pollClipboard. Zaglavlja CIJELE grupe idu prva,
+        // jedno za drugim, prije ijednog bajta podataka. Bez toga bi druga
+        // strana znala samo za datoteku koja je upravo na redu, pa bi opisnik
+        // meduspremnika mogla sastaviti tek kad su sve osim zadnje datoteke
+        // vec poslane - kod mape s tisucama datoteka to je cijeli prijenos.
+        bool headerSent = false;
+    };
+
+    struct Connection
+    {
+        QTcpSocket* socket = nullptr;
+        QByteArray buffer;
+        bool greeted = false;
+        QString peer;
+
+        // File currently being received
+        bool rxActive = false;
+        QFile rxFile;
+        qint64 rxGot = 0;
+        QString rxPath;
+
+        // Clipboard file group currently being received, if any
+        bool groupActive = false;
+        int groupRemaining = 0;
+        QStringList groupPaths;
+
+        // Set once we have replied "NO" and are about to hang up
+        bool rejected = false;
+
+        // Outgoing files, oldest first. txActive covers txCurrent: while it is
+        // set, txFile is open and chunks are still being fed to the socket.
+        QQueue<TxItem> txQueue;
+        TxItem txCurrent;
+        QFile txFile;
+        bool txActive = false;
+        qint64 txSent = 0;
+
+        // Guards pumpSend against re-entering itself through bytesWritten.
+        bool txBusy = false;
+
+        // Set while the far side has asked us to stop pushing the file that is
+        // currently on the wire (kFrameHold). It is waiting for its own user to
+        // paste, which can take minutes. While it is set nothing is fed to the
+        // socket in this direction and the stall detector leaves TX alone -
+        // otherwise a deliberate pause looks exactly like a dead link and the
+        // 20 s rule would abort it. See handleFrame and checkStalls.
+        bool txHeld = false;
+        qint64 txHeldMs = 0;
+
+        // Files whose chunks are all buffered but which may not be moved out of
+        // Drop\ yet - the socket still holds the tail of them.
+        QVector<TxItem> txMoves;
+
+        // Clipboard group accounting: grpLeft counts the files still on the
+        // wire, so the "poslano N datoteka" line appears exactly once per group
+        // instead of once per file.
+        int grpLeft = 0;
+        int grpCount = 0;
+        qint64 grpBytes = 0;
+
+        // When the last byte really moved on this socket, in each direction.
+        // A link that dies quietly (a route disappears, the far side is killed)
+        // leaves the socket in ConnectedState for hours - Windows keepalive is
+        // off by default, so nothing ever reports the loss. Without these two
+        // stamps a transfer would sit there holding a socket that goes nowhere,
+        // and the only symptom would be "nothing happens". See checkStalls.
+        qint64 txProgressMs = 0;
+        qint64 rxProgressMs = 0;
+    };
+
+    void processBuffer(Connection* conn);
+    bool handleFrame(Connection* conn, quint8 type, const QByteArray& payload);
+    void finishReceiving(Connection* conn);
+
+    void sendFrame(Connection* conn, quint8 type, const QByteArray& payload);
+
+    // Queues a file for the other side. Returns false, and queues nothing, when
+    // the file is gone or over the size policy - the same verdict the old
+    // synchronous sender handed back. Name and size are filled in here, so a
+    // caller only has to say where the file is and what to do once it is out.
