+// Frame types, matching luxstream-bridge.ps1
+static constexpr quint8 kFrameGreeting = 0x01;
+static constexpr quint8 kFrameGreetingReply = 0x02;
+static constexpr quint8 kFrameText = 0x10;
+static constexpr quint8 kFrameImage = 0x11;
+static constexpr quint8 kFrameClipGroup = 0x12;
+static constexpr quint8 kFrameFileHeader = 0x20;
+static constexpr quint8 kFrameFileChunk = 0x21;
+static constexpr quint8 kFrameFileEnd = 0x22;
+
+// Added 01.11.2026. together with the lazy paste on the other side.
+//
+// The receiver now puts the clipboard up BEFORE the bytes arrive: it creates a
+// file of the announced size, hands Explorer that path, and only then asks us
+// to wait. The point of the hold frame is that "wait" has to mean wait - the
+// whole complaint being fixed was that Ctrl+C started the transfer, so a paste
+// made while the transfer was still running grabbed whatever was on the
+// clipboard at that moment and the file never reached the paste destination.
+//
+// An older peer knows neither frame and answers with "nepoznat tip okvira",
+// which is logged and ignored - so a new VM against an old host, or the other
+// way round, degrades to the old behaviour instead of breaking.
+static constexpr quint8 kFrameHold = 0x30;
+static constexpr quint8 kFrameResume = 0x31;
+
+// Added 01.11.2026. The far side stops wanting the file the pause was holding
+// on. Normally that means its user copied something else instead of pasting:
+// the pause can last ten minutes, and for all of it the other side's bridge
+// stops polling its own clipboard as well (see Sync-Loop in
+// luxstream-bridge.ps1), so a plain text copy froze in BOTH directions. Seen
+// in the field: two full 10-minute windows (14:56-15:06 and 15:12-15:22 on
+// 01.11.2026.) during which copying text simply did nothing.
+//
+// Lifting the hold alone is not enough - kFrameResume would start pushing the
+// very file nobody is waiting for any more, so the queued job goes with it.
+// An older peer logs this as an unknown frame and ignores it, which leaves the
+// old behaviour intact instead of breaking.
+static constexpr quint8 kFrameAbandon = 0x32;
+
+// ---------------------------------------------------------------------------
+// Progress window
+//
+// The bridge had no way at all to show that a copy was running: a 4.9 GB file
+// took two and a half minutes and the only sign of life was a log line at the
+// end. This is the missing feedback.
+//
+// It is a plain Win32 window on its own thread, not a Qt dialog. Moonlight is
+// a Qt Quick application built on QGuiApplication, so QtWidgets - and with it
+// QProgressDialog - is not linked at all, and linking it would mean shipping
+// another Qt DLL and starting the app as QApplication instead. A native window
+// needs only user32/gdi32, which the app already links, and because it never
+// touches Qt's event loop it cannot stall a transfer or the clipboard poll.
+// ---------------------------------------------------------------------------
+#ifdef Q_OS_WIN
+namespace {
+
+constexpr UINT kMsgRepaint = WM_APP + 1;
+constexpr UINT kMsgShow = WM_APP + 2;
+constexpr UINT kMsgHide = WM_APP + 3;
+
+struct ProgressWindow
+{
+    HWND          hwnd = nullptr;
+    std::thread   worker;
+    std::mutex    textMutex;
+    QString       title;
+    QString       name;
+
+    std::atomic<qint64> total{0};
+    std::atomic<qint64> done{0};
+    std::atomic<qint64> speed{0};
+    std::atomic<bool>   finished{false};
+
+    bool started = false;
+    bool visible = false;
+};
+
+ProgressWindow g_pw;
+
+QString fmtAmount(qint64 bytes)
+{
+    if (bytes >= 1024LL * 1024 * 1024) {
+        return QStringLiteral("%1 GB").arg(QString::number(bytes / 1073741824.0, 'f', 2));
+    }
+    return QStringLiteral("%1 MB").arg(QString::number(bytes / 1048576.0, 'f', 1));
+}
+
+QString fmtEta(qint64 seconds)
+{
+    if (seconds < 0) {
+        return QStringLiteral("--:--");
+    }
+    const qint64 h = seconds / 3600;
+    const qint64 m = (seconds % 3600) / 60;
+    const qint64 s = seconds % 60;
+    if (h > 0) {
+        return QStringLiteral("%1:%2:%3").arg(h)
+                .arg(m, 2, 10, QLatin1Char('0')).arg(s, 2, 10, QLatin1Char('0'));
+    }
+    return QStringLiteral("%1:%2").arg(m).arg(s, 2, 10, QLatin1Char('0'));
+}
+
+HFONT makeFont(double scale, int pointSize, bool bold)
+{
+    return CreateFontW(-static_cast<int>(pointSize * scale * 96.0 / 72.0 + 0.5),
+                       0, 0, 0,
+                       bold ? FW_SEMIBOLD : FW_NORMAL,
+                       FALSE, FALSE, FALSE,
+                       DEFAULT_CHARSET, OUT_DEFAULT_PRECIS, CLIP_DEFAULT_PRECIS,
+                       CLEARTYPE_QUALITY, DEFAULT_PITCH | FF_DONTCARE,
+                       L"Segoe UI");
+}
+
+void fillRect(HDC dc, const RECT& rc, COLORREF color)
+{
+    HBRUSH brush = CreateSolidBrush(color);
+    FillRect(dc, &rc, brush);
+    DeleteObject(brush);
+}
+
+void drawCard(HWND hwnd, HDC dc)
+{
+    RECT rc;
+    GetClientRect(hwnd, &rc);
+
+    const UINT dpi = GetDpiForWindow(hwnd) != 0 ? GetDpiForWindow(hwnd) : 96;
+    const double s = dpi / 96.0;
+
+    const qint64 total = g_pw.total.load();
+    const qint64 done = g_pw.done.load();
+    const qint64 speed = g_pw.speed.load();
+    const bool finished = g_pw.finished.load();
+
+    QString title;
+    QString name;
+    {
+        std::lock_guard<std::mutex> lock(g_pw.textMutex);
+        title = g_pw.title;
+        name = g_pw.name;
+    }
+
+    const int pad = static_cast<int>(16 * s);
+
+    // Card
+    fillRect(dc, rc, RGB(30, 31, 36));
+
+    {
+        HPEN pen = CreatePen(PS_SOLID, 1, RGB(64, 67, 76));
+        HGDIOBJ oldPen = SelectObject(dc, pen);
+        HGDIOBJ oldBrush = SelectObject(dc, GetStockObject(NULL_BRUSH));
+        Rectangle(dc, rc.left, rc.top, rc.right, rc.bottom);
+        SelectObject(dc, oldBrush);
+        SelectObject(dc, oldPen);
+        DeleteObject(pen);
+    }
+
+    SetBkMode(dc, TRANSPARENT);
+
+    // Title, left; percent, right
+    {
+        HFONT font = makeFont(s, 11, true);
+        HGDIOBJ old = SelectObject(dc, font);
+        SetTextColor(dc, RGB(235, 235, 240));
+
+        RECT r{ rc.left + pad, rc.top + static_cast<int>(10 * s),
+                rc.right - pad, rc.top + static_cast<int>(32 * s) };
+        DrawTextW(dc, reinterpret_cast<const wchar_t*>(title.utf16()), -1, &r,
+                  DT_LEFT | DT_SINGLELINE | DT_VCENTER | DT_END_ELLIPSIS);
+
+        const int pct = (total > 0) ? static_cast<int>(done * 100 / total)
+                                    : (finished ? 100 : 0);
+        const QString pctText = QStringLiteral("%1 %").arg(pct);
+        DrawTextW(dc, reinterpret_cast<const wchar_t*>(pctText.utf16()), -1, &r,
+                  DT_RIGHT | DT_SINGLELINE | DT_VCENTER);
+
+        SelectObject(dc, old);
+        DeleteObject(font);
+    }
+
+    // File name
+    {
+        HFONT font = makeFont(s, 10, false);
+        HGDIOBJ old = SelectObject(dc, font);
+        SetTextColor(dc, RGB(190, 193, 200));
+
+        RECT r{ rc.left + pad, rc.top + static_cast<int>(34 * s),
+                rc.right - pad, rc.top + static_cast<int>(54 * s) };
+        DrawTextW(dc, reinterpret_cast<const wchar_t*>(name.utf16()), -1, &r,
+                  DT_LEFT | DT_SINGLELINE | DT_VCENTER | DT_END_ELLIPSIS | DT_PATH_ELLIPSIS);
+
+        SelectObject(dc, old);
+        DeleteObject(font);
+    }
+
+    // Bar
+    const int barTop = rc.top + static_cast<int>(62 * s);
+    const int barHeight = static_cast<int>(10 * s);
+    RECT track{ rc.left + pad, barTop, rc.right - pad, barTop + barHeight };
+    fillRect(dc, track, RGB(56, 58, 66));
+
+    double fraction = 0.0;
+    if (total > 0) {
+        fraction = static_cast<double>(done) / static_cast<double>(total);
+    }
+    else if (finished) {
+        fraction = 1.0;
+    }
+    if (fraction < 0.0) {
+        fraction = 0.0;
+    }
+    if (fraction > 1.0) {
+        fraction = 1.0;
+    }
+    if (fraction > 0.0) {
+        RECT fill = track;
+        fill.right = track.left + static_cast<int>((track.right - track.left) * fraction);
+        if (fill.right <= fill.left) {
+            fill.right = fill.left + 1;
+        }
+        fillRect(dc, fill, finished ? RGB(120, 200, 140) : RGB(120, 150, 255));
+    }
+
+    // Detail line
+    {
+        HFONT font = makeFont(s, 9, false);
+        HGDIOBJ old = SelectObject(dc, font);
+        SetTextColor(dc, RGB(150, 155, 165));
+
+        QString detail;
+        if (total > 0) {
+            detail = QStringLiteral("%1 / %2").arg(fmtAmount(done)).arg(fmtAmount(total));
+        }
+        else {
+            detail = fmtAmount(done);
+        }
+
+        if (speed > 0 && !finished) {
+            detail += QStringLiteral("   \u2022   %1 MB/s").arg(QString::number(speed / 1048576.0, 'f', 1));
+            if (total > 0 && done < total) {
+                detail += QStringLiteral("   \u2022   ostalo %1")
+                        .arg(fmtEta(static_cast<qint64>((total - done) / static_cast<double>(speed))));
+            }
+        }
+        else if (finished) {
+            detail += QStringLiteral("   \u2022   gotovo");
+        }
+
+        RECT r{ rc.left + pad, rc.top + static_cast<int>(78 * s),
+                rc.right - pad, rc.top + static_cast<int>(98 * s) };
+        DrawTextW(dc, reinterpret_cast<const wchar_t*>(detail.utf16()), -1, &r,
+                  DT_LEFT | DT_SINGLELINE | DT_VCENTER | DT_END_ELLIPSIS);
+
+        SelectObject(dc, old);
+        DeleteObject(font);
+    }
+}
+
+LRESULT CALLBACK progressProc(HWND hwnd, UINT msg, WPARAM wp, LPARAM lp)
+{
+    switch (msg) {
+    case kMsgRepaint:
+        InvalidateRect(hwnd, nullptr, FALSE);
+        return 0;
+
+    case kMsgShow:
+        ShowWindow(hwnd, SW_SHOWNOACTIVATE);
+        InvalidateRect(hwnd, nullptr, FALSE);
+        return 0;
+
+    case kMsgHide:
+        ShowWindow(hwnd, SW_HIDE);
+        return 0;
+
+    case WM_ERASEBKGND:
+        return 1;   // the whole card is painted in WM_PAINT - no flicker
+
+    case WM_PAINT:
+    {
+        PAINTSTRUCT ps;
+        HDC dc = BeginPaint(hwnd, &ps);
+        drawCard(hwnd, dc);
+        EndPaint(hwnd, &ps);
+        return 0;
+    }
+
+    case WM_DESTROY:
+        PostQuitMessage(0);
+        return 0;
+    }
+
+    return DefWindowProcW(hwnd, msg, wp, lp);
+}
+
+void progressThread()
+{
+    WNDCLASSEXW wc{};
+    wc.cbSize = sizeof(wc);
+    wc.lpfnWndProc = progressProc;
+    wc.hInstance = GetModuleHandleW(nullptr);
+    wc.hCursor = LoadCursorW(nullptr, IDC_ARROW);
+    wc.lpszClassName = L"LuxstreamProgressWnd";
+    RegisterClassExW(&wc);
+
+    const UINT dpi = GetDpiForSystem() != 0 ? GetDpiForSystem() : 96;
+    const double s = dpi / 96.0;
+    const int w = static_cast<int>(430 * s);
+    const int h = static_cast<int>(108 * s);
+
+    RECT work{};
+    SystemParametersInfoW(SPI_GETWORKAREA, 0, &work, 0);
+    const int x = work.right - w - static_cast<int>(16 * s);
+    const int y = work.bottom - h - static_cast<int>(16 * s);
+
+    // No caption and no activation: it is an indicator, not a window to work
+    // with, and it must never steal focus from the stream or the desktop.
+    HWND hwnd = CreateWindowExW(WS_EX_TOOLWINDOW | WS_EX_TOPMOST | WS_EX_NOACTIVATE,
+                                L"LuxstreamProgressWnd", L"Luxstream",
+                                WS_POPUP,
+                                x, y, w, h,
+                                nullptr, nullptr, GetModuleHandleW(nullptr), nullptr);
+    if (hwnd == nullptr) {
+        return;
+    }
+
+    g_pw.hwnd = hwnd;
+
+    MSG msg;
+    while (GetMessageW(&msg, nullptr, 0, 0) > 0) {
+        TranslateMessage(&msg);
+        DispatchMessageW(&msg);
+    }
+}
+
+void progressPoke(UINT msg)
+{
+    if (g_pw.hwnd != nullptr) {
+        PostMessageW(g_pw.hwnd, msg, 0, 0);
+    }
+}
+
+void luxProgressShow(const QString& title, const QString& name)
+{
+    {
+        std::lock_guard<std::mutex> lock(g_pw.textMutex);
+        g_pw.title = title;
+        g_pw.name = name;
+    }
+
+    if (!g_pw.started) {
+        g_pw.started = true;
+        g_pw.worker = std::thread(progressThread);
+        // The window has to exist before the first repaint can be posted, or
+        // the first update is silently dropped. Bounded, because a failure to
+        // create the window must not hold up the transfer.
+        for (int i = 0; i < 200 && g_pw.hwnd == nullptr; i++) {
+            Sleep(5);
+        }
+        g_pw.worker.detach();
+    }
+
+    if (g_pw.hwnd == nullptr) {
+        return;         // no window (headless?) - the transfer goes on regardless
+    }
+
+    progressPoke(kMsgShow);
+    g_pw.visible = true;
+}
+
+void luxProgressUpdate(qint64 total, qint64 done, qint64 speed, bool finished,
+                       const QString& name)
+{
+    if (g_pw.hwnd == nullptr || !g_pw.visible) {
+        return;
+    }
+
+    if (!name.isEmpty()) {
+        std::lock_guard<std::mutex> lock(g_pw.textMutex);
+        g_pw.name = name;
+    }
+
+    g_pw.total.store(total);
+    g_pw.done.store(done);
+    g_pw.speed.store(speed);
+    g_pw.finished.store(finished);
+    progressPoke(kMsgRepaint);
+}
+
+void luxProgressHide()
+{
+    if (g_pw.hwnd == nullptr) {
+        return;
+    }
+    progressPoke(kMsgHide);
+    g_pw.visible = false;
+}
+
+}   // namespace
+#else
+namespace {
+void luxProgressShow(const QString&, const QString&) {}
+void luxProgressUpdate(qint64, qint64, qint64, bool, const QString&) {}
+void luxProgressHide() {}
+}   // namespace
+#endif
