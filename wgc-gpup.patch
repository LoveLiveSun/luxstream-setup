From 5247ed937e6992448ef9155b2aac4f5ba73483d1 Mon Sep 17 00:00:00 2001
From: Vjeko <105038487+VjekoslavDugec@users.noreply.github.com>
Date: Thu, 20 Aug 2026 17:46:48 +0200
Subject: [PATCH] fix(capture/windows): do not gate outputs behind the Desktop
 Duplication probe when capture=wgc

Sunshine filters every DXGI output through test_dxgi_duplication() in both
display_names() and display_base_t::init(). On a host whose display is owned by
a paravirtualized adapter (Hyper-V GPU-P / GPU-PV), IDXGIOutput1::DuplicateOutput()
fails with E_INVALIDARG (0x80070057) for every output, on every adapter, because
the guest-side display driver does not implement the duplication path at all.

The result is that Sunshine reports no capturable displays on such a host, even
though its own Windows.Graphics.Capture backend can capture them: WGC is serviced
by DWM and does not go through the display driver.

Measured on Windows 10 19044 in a Hyper-V guest with an RTX 4090 shared via GPU-P,
against a single output at the same moment in time:

    OUTPUT \.\DISPLAY65 1920x1080 attached=yes
      IDXGIOutput1::DuplicateOutput()          -> 0x80070057
      GraphicsCaptureItem CreateForMonitor()   -> S_OK
      Direct3D11CaptureFramePool + session     -> frames delivered, 1920x1080

Route both call sites through a new test_capture_supported() that skips the
Desktop Duplication probe when the user has explicitly configured capture=wgc.
Automatic backend selection is deliberately left unchanged: with no explicit
capture setting, Desktop Duplication is still probed first, so no existing
configuration changes behaviour.

Also add a workflow_dispatch workflow that builds only the Windows installer,
for testing this on a fork without running the full release matrix.
---
 .github/workflows/build-windows-only.yml | 36 ++++++++++++++++++++++++
 src/platform/windows/display_base.cpp    | 35 +++++++++++++++++++++--
 2 files changed, 69 insertions(+), 2 deletions(-)
 create mode 100644 .github/workflows/build-windows-only.yml

diff --git a/.github/workflows/build-windows-only.yml b/.github/workflows/build-windows-only.yml
new file mode 100644
index 0000000..cd7a6aa
--- /dev/null
+++ b/.github/workflows/build-windows-only.yml
@@ -0,0 +1,36 @@
+---
+# Builds ONLY the Windows installer, on demand.
+#
+# The upstream CI workflow builds Docker, Flatpak, FreeBSD, macOS, Linux and
+# Windows in one run. On a personal fork most of those jobs fail for lack of
+# repository secrets, and the whole run takes hours. This workflow reuses the
+# upstream Windows job and nothing else.
+#
+# Run it from the Actions tab: "Build Windows only" -> "Run workflow".
+name: Build Windows only
+permissions: {}
+
+on:
+  workflow_dispatch:
+
+jobs:
+  version:
+    name: Version
+    runs-on: ubuntu-latest
+    outputs:
+      version: ${{ steps.v.outputs.version }}
+    steps:
+      - name: Generate a date based version
+        id: v
+        run: echo "version=$(date -u +'%Y.%-m%d.%H%M%S')" >> "$GITHUB_OUTPUT"
+
+  build-windows:
+    name: Windows
+    needs: version
+    permissions:
+      contents: read
+    uses: ./.github/workflows/ci-windows.yml
+    with:
+      publish_release: 'false'
+      release_commit: ${{ github.sha }}
+      release_version: ${{ needs.version.outputs.version }}
diff --git a/src/platform/windows/display_base.cpp b/src/platform/windows/display_base.cpp
index b297b90..8db0fbc 100644
--- a/src/platform/windows/display_base.cpp
+++ b/src/platform/windows/display_base.cpp
@@ -428,6 +428,37 @@ namespace platf::dxgi {
     return false;
   }
 
+  /**
+   * @brief Tests whether the configured capture backend can capture the given output.
+   * @details Desktop Duplication cannot capture an output owned by a paravirtualized
+   *          display adapter (GPU-P / GPU-PV). `IDXGIOutput1::DuplicateOutput()` fails
+   *          there with `E_INVALIDARG` no matter which adapter or device is used, because
+   *          the guest-side driver does not implement the duplication path at all.
+   *
+   *          Windows.Graphics.Capture does not go through the display driver; it is
+   *          serviced by DWM, and it captures those outputs successfully. Sunshine
+   *          already ships a complete WGC backend, but every output is gated behind the
+   *          Desktop Duplication probe before that backend is ever reached, so on such a
+   *          host Sunshine reports no capturable displays.
+   *
+   *          When the user has explicitly selected `capture = wgc`, the Desktop
+   *          Duplication probe is not a meaningful capability test, so skip it. Automatic
+   *          backend selection is unchanged: it still probes Desktop Duplication first.
+   *
+   * @param adapter The DXGI adapter to use for capture.
+   * @param output The DXGI output to capture.
+   * @param enumeration_only Specifies whether this test is occurring for display enumeration.
+   *
+   * @return True when the configured capture backend can capture the requested output.
+   */
+  bool test_capture_supported(adapter_t &adapter, output_t &output, bool enumeration_only) {
+    if (config::video.capture == "wgc") {
+      return true;
+    }
+
+    return test_dxgi_duplication(adapter, output, enumeration_only);
+  }
+
   /**
    * @brief Hook for NtGdiDdDDIGetCachedHybridQueryValue() from win32u.dll.
    * @param gpuPreference A pointer to the location where the preference will be written.
@@ -511,7 +542,7 @@ namespace platf::dxgi {
             continue;
           }
 
-          if (desc.AttachedToDesktop && test_dxgi_duplication(adapter_tmp, output_tmp, false)) {
+          if (desc.AttachedToDesktop && test_capture_supported(adapter_tmp, output_tmp, false)) {
             output = std::move(output_tmp);
 
             offset_x = desc.DesktopCoordinates.left;
@@ -1108,7 +1139,7 @@ namespace platf {
           << std::endl;
 
         // Don't include the display in the list if we can't actually capture it
-        if (desc.AttachedToDesktop && dxgi::test_dxgi_duplication(adapter, output, true)) {
+        if (desc.AttachedToDesktop && dxgi::test_capture_supported(adapter, output, true)) {
           display_names.emplace_back(std::move(device_name));
         }
       }
-- 
2.55.0.windows.4

